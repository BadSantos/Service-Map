{
  "name": "@workspace/services-map",
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.26.1",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10.26.1"
  },
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "dev": "vite --config vite.config.ts --host 0.0.0.0",
    "dev:local": "vite --config vite.config.ts --mode standalone --host 127.0.0.1 --port 5173",
    "build": "pnpm run typecheck && vite build --config vite.config.ts",
    "build:local": "pnpm run typecheck && vite build --config vite.config.ts --mode standalone",
    "serve": "vite preview --config vite.config.ts --host 0.0.0.0",
    "serve:local": "vite preview --config vite.config.ts --mode standalone --host 127.0.0.1 --port 4173",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit",
    "test:services-map": "node --test src/lib/service-data.test.ts",
    "check": "pnpm run typecheck && pnpm run test:services-map && pnpm run build"
  },
  "private": true,
  "devDependencies": {
    "@replit/vite-plugin-cartographer": "catalog:",
    "@replit/vite-plugin-dev-banner": "catalog:",
    "@replit/vite-plugin-runtime-error-modal": "catalog:",
    "@tailwindcss/typography": "^0.5.15",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@vitejs/plugin-vue": "6.0.0",
    "clsx": "catalog:",
    "tailwind-merge": "catalog:",
    "tailwindcss": "catalog:",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.2",
    "vite": "catalog:",
    "vue-tsc": "3.0.6"
  },
  "dependencies": {
    "vue": "3.5.22",
    "vue-router": "4.5.1"
  }
}
